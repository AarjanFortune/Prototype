# Environment Variables Template

# Backend Environment
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Model Configuration
MODEL_PATH=models/tabest_model.pth
DEVICE=cuda  # or cpu

# Audio Processing
SAMPLE_RATE=22050
HOP_LENGTH=512
MAX_AUDIO_DURATION=600

# CORS (Frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Feature Extraction
DEFAULT_FEATURE_TYPE=cqt

# Logging
LOG_LEVEL=info

# Optional: GPU Configuration
CUDA_VISIBLE_DEVICES=0
TORCH_NUM_THREADS=4
